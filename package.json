{
  "name": "@webcrawlerapi/stealth",
  "version": "1.0.0",
  "description": "Zero-dependency stealth layer for Puppeteer / CDP browsers (works with launch() and connect()).",
  "main": "stealth.js",
  "types": "stealth.d.ts",
  "files": [
    "stealth.js",
    "stealth.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "example:connect": "node examples/connect.js",
    "example:launch": "node examples/launch.js"
  },
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "puppeteer": ">=19",
    "puppeteer-core": ">=19"
  },
  "peerDependenciesMeta": {
