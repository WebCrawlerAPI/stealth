      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebCrawlerAPI/stealth.git"
  }
}
